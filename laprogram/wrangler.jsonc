{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "laprogram",
  "compatibility_date": "2026-03-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "laprogram",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "data",
      "database_name": "data_f26",
      "database_id": "0a2b0482-823c-4aa2-8703-3798386157e6",
      "migrations_dir": "./migrations",
    },
  ],
  "r2_buckets": [
    {
      "bucket_name": "storage-f26",
      "binding": "storage",
      "remote": true,
    },
    {
      "bucket_name": "db-backups",
      "binding": "db_backups",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "config",
      "id": "d46813456a634d51b1a534c00cc2dd7a",
    },
  ],
}
